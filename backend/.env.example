APP_NAME=DISTRIVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=distriva_db
DB_USERNAME=distriva_user
DB_PASSWORD=

DISTRIVA_AUTHORIZATION_GUARD=web
DISTRIVA_BUSINESS_TIMEZONE=Asia/Jakarta

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Notifications (docs/56) ---------------------------------------------------------------------
# Check completeness WITHOUT sending anything:  php artisan distriva:notify-check
DISTRIVA_NOTIFY_CHANNELS=mail,whatsapp

# E-mail (SMTP). Port 587 -> leave MAIL_SCHEME empty (STARTTLS); port 465 -> MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DISTRIVA"

# WhatsApp via Starsender (docs.starsender.online/docs/message-api/kirim-pesan).
# DISTRIVA_WHATSAPP_TOKEN = "API key device" from the Starsender device menu. Real value ONLY in backend/.env.
DISTRIVA_WHATSAPP_DRIVER=http
DISTRIVA_WHATSAPP_URL=https://api.starsender.online/api/send
DISTRIVA_WHATSAPP_METHOD=POST
DISTRIVA_WHATSAPP_AUTH_HEADER=Authorization
DISTRIVA_WHATSAPP_AUTH_PREFIX=
DISTRIVA_WHATSAPP_TOKEN=
DISTRIVA_WHATSAPP_BODY_FORMAT=json
DISTRIVA_WHATSAPP_BODY={"messageType":"text","to":"{phone}","body":"{message}"}
DISTRIVA_WHATSAPP_SUCCESS_PATH=success
DISTRIVA_WHATSAPP_SUCCESS_VALUE=true
DISTRIVA_WHATSAPP_COUNTRY_CODE=62

# Web app URL used in activation invitations (no trailing slash)
DISTRIVA_FRONTEND_URL=
# OTP (activation / recovery): length 6, valid minutes, wrong guesses before the code is void, resend cooldown, max requests per hour per e-mail
DISTRIVA_OTP_TTL_MINUTES=10
DISTRIVA_OTP_MAX_ATTEMPTS=5
DISTRIVA_OTP_RESEND_COOLDOWN=60
DISTRIVA_OTP_MAX_REQUESTS_PER_HOUR=5

# Documents module (survey photos, drawings): ABSOLUTE path on the media drive, outside the project and the web root.
# Check it with: php artisan distriva:documents-check
# DISTRIVA_DOCUMENTS_ROOT=/media/data/DISTRIVA-files/documents

# Backup / restore (docs/64): ABSOLUTE path on the media drive, outside the project, the web root and the documents folder.
# DISTRIVA_BACKUP_ROOT=
# Scheduled backups need the standard Laravel cron entry:  * * * * * cd /path/to/backend && php artisan schedule:run >> /dev/null 2>&1
# DISTRIVA_PHP_BINARY=php
