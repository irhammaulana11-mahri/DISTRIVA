# Copy to .env and fill in. NEVER commit .env. Rotate any password that was ever written in the code.
EIS_USERNAME=
EIS_PASSWORD=
# DISTRIVA (the account must hold applications.import; SYS_ADMIN also needs MFA, which a scheduled job cannot give)
# Alamat backend Laravel. `php artisan serve` pindah ke port 8001, 8002, ... bila 8000 dipakai program lain (di mesin pengembangan ini 8000 dipakai aplikasi pencetak HP): pakai port yang tertulis saat serve dijalankan.
DISTRIVA_URL=http://127.0.0.1:8001
DISTRIVA_EMAIL=
DISTRIVA_PASSWORD=
# Diisi DISTRIVA sendiri saat sinkronisasi dimulai dari tombol (token berumur pendek); bila ada, email/password di atas tidak dipakai
DISTRIVA_TOKEN=
# Range Mohon = hari ini - EIS_LOOKBACK_DAYS .. hari ini (6 bulan = 180)
EIS_LOOKBACK_DAYS=180
# Sejauh apa sinkron boleh mundur untuk memperbarui permohonan lama yang masih berjalan di DISTRIVA (hari)
EIS_MAX_BACKFILL_DAYS=180
EIS_JENIS_MOHON=PB/PD/PS
EIS_DOWNLOAD_DIR=downloads
EIS_HEADLESS=0
# Tidak ada koneksi basis data di alur permohonan: data masuk ke PostgreSQL DISTRIVA (distriva_db) lewat API di atas, supaya aturan impor, pemetaan status, dan catatan perubahan DISTRIVA tetap berlaku.
# (MONGO_URI hanya untuk alur piutang lama, python piutang.py; isi hanya bila alur itu masih dipakai.)
